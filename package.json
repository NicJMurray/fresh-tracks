{
  "name": "fresh-tracks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "npm run check && npm test && wrangler deploy --dry-run --outdir .build",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply fresh-tracks --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "4.152.0"
  }
}
